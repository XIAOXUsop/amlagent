          "event": [{ "listen": "test", "script": { "exec": ["pm.test('幂等重放返回成功', () => pm.response.to.have.status(200));", "pm.test('标记为幂等重放', () => pm.expect(pm.response.json().idempotentReplay).to.eql(true));"], "type": "text/javascript" } }]
