            "body": { "mode": "raw", "raw": "{\n  \"sourceSystem\": \"MANUAL\",\n  \"externalEventId\": \"{{refundEventId}}\",\n  \"eventStatus\": \"REQUESTED\",\n  \"payerSubject\": \"客户主体\",\n  \"payeeSubject\": \"原付款主体\",\n  \"payeeAccountRef\": \"ACCT-B\",\n  \"amount\": 100.00,\n  \"currency\": \"CNY\",\n  \"effectiveAt\": \"2026-09-09T12:00:00\",\n  \"allocations\": []\n}" },
