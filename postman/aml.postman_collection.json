          "event": [{ "listen": "test", "script": { "exec": ["pm.test('累计超额退款被拒绝', () => pm.response.to.have.status(400));", "pm.expect(pm.response.text()).to.match(/累计|超过|RF-14/);"], "type": "text/javascript" } }]
