        },
        {
          "name": "P15 保存已过期授权草稿（提交前置）",
          "event": [
            { "listen": "prerequest", "script": { "exec": ["const txId = pm.collectionVariables.get('txId');", "const amount = pm.collectionVariables.get('txAmount');", "const artifactId = Number(pm.collectionVariables.get('artifactVersionId'));", "const questions = {};", "['Q1','Q2','Q3','Q4','Q5','Q6'].forEach(code => { questions[code] = {assessment:'SATISFIED',judgement:`${code} 已完成核验且仅对授权有效期进行本次对抗`,factLocation:'CORE_BANKING 流水及授权材料',factKind:'OBSERVED_FACT',verificationMethod:'INDEPENDENT_SOURCE_CHECK',limitations:'仅覆盖冻结范围',artifactVersionIds:[artifactId]}; });", "const draft = {policy:{businessRole:'集团代付',paymentStage:'DELIVERED_SETTLEMENT',payerMatchesContractBuyer:false,payeeMatchesContractSeller:true,groupRelationshipStatus:'GROUP_RELATIONSHIP_CONFIRMED'},scope:{reviewedTransactionIds:[txId],scopeEnumerationNote:'已核对冻结范围',transactionAmounts:{[txId]:amount},allocations:[{transactionId:txId,amount}]},claims:{C1:{status:'SUPPORTED',judgement:'已确认付款主体'},C2:{status:'SUPPORTED',judgement:'已确认付款义务'},C3:{status:'SUPPORTED',judgement:'声称存在授权'},C4:{status:'SUPPORTED',judgement:'声称金额受覆盖'}},authority:{authorityRef:'AU-EXPIRED',limitAmount:amount,coveredTransactionIds:[txId],facts:[{authorityRef:'AU-EXPIRED',effectiveFrom:'2020-01-01',effectiveTo:'2020-12-31',factType:'GRANTED'}]},questions,outcome:'EXPLAINED'};", "pm.variables.set('expiredDraftBody', JSON.stringify({expectedDraftRevision:Number(pm.collectionVariables.get('draftRevision')),draftJson:JSON.stringify(draft)}));"], "type": "text/javascript" } },
            { "listen": "test", "script": { "exec": ["pm.test('过期授权草稿保存成功以进入提交门禁', () => pm.response.to.have.status(200));", "pm.collectionVariables.set('draftRevision', pm.response.json().draftRevision);"], "type": "text/javascript" } }
